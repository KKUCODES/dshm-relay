{
  "name": "dsh-mobile-backend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @dsh-mobile/protocol && npm run build -w @dsh-mobile/gateway",
    "test": "vitest run",
    "test:postgres": "node scripts/test-postgres.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "start": "npm run start -w @dsh-mobile/gateway"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.6-alpha.2",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
