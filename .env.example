# Docker Compose 使用。DOMAIN 不含协议、路径或端口。
DOMAIN=relay.example.com
# private = 个人使用，校验注册密钥（默认）；open = 开放使用，免注册密钥。
REGISTRATION_MODE=private
# 分别运行两次 node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 数据库密码必须替换；使用 base64url，避免 DATABASE_URL 的 URL 转义问题。
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_BASE64URL_PASSWORD
# 仅 private 模式必须填写；open 模式可删除本行，不校验此值。
ENROLLMENT_TOKEN=REPLACE_WITH_43_CHARACTER_BASE64URL_TOKEN

# 原生开发时单独设置以下变量（不要提交真实值）：
# DATABASE_URL=postgresql://dsh_mobile:password@127.0.0.1:5432/dsh_mobile
# PUBLIC_ORIGIN=http://127.0.0.1:8787
# HTTP/HTTPS 均支持；HTTP 不加密，建议使用 HTTPS。
# HOST=127.0.0.1
# PORT=8787
